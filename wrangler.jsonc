{
  "name": "gaysurrogacy",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-11-07",
  // Before every deploy / dev (run wrangler from the repo root): site/wiki_index.json ->
  // site/wiki_search.json, the search snapshot the Worker loads instead of indexing pages.
  "build": { "command": "npm --prefix worker run build-search", "watch_dir": "./worker/src" },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The script runs for the MCP endpoint and for page URLs (the home page and every path ending
    // in "/"), where it answers "Accept: text/markdown" with the page's markdown twin. Every other
    // request (assets, search index, the twins and llms.txt themselves) is a free static-asset hit.
    "run_worker_first": ["/mcp", "/", "/*/"]
  },
  "routes": [{ "pattern": "gaysurrogacy.co.il", "custom_domain": true }]
}
