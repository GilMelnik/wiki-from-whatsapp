{
  "data_dir": "data",
  "logging": {
    "level": "INFO",
    "max_bytes": 5242880,
    "backup_count": 3
  },
  "llm_client": {
    "stages": {
      "extract": {"provider": "anthropic", "model": "claude-sonnet-5-5", "thinking_param": "low"},
      "plan": {"provider": "anthropic", "model": "claude-opus-5-5", "thinking_param": "high"},
      "generate": {"provider": "anthropic", "model": "claude-sonnet-5-5", "thinking_param": "high"},
      "write": {"provider": "anthropic", "model": "claude-sonnet-5-5", "thinking_param": "high"},
      "review": {"provider": "anthropic", "model": "claude-opus-5-5", "thinking_param": "high"},
      "apply": {"provider": "anthropic", "model": "claude-sonnet-5-5", "thinking_param": "medium"},
      "propose": {"provider": "anthropic", "model": "claude-sonnet-5-5", "thinking_param": "low"},
      "update": {"provider": "anthropic", "model": "claude-sonnet-5-5", "thinking_param": "medium"}
    },
    "batch_poll_interval": 30.0,
    "max_tokens_ceiling": 16384,
    "json_parse_retries": 2,
    "default_temperature": 0.2,
    "default_max_tokens": 8192,
    "cache_dir": "shared/llm_cache",
    "failure_log": "shared/llm_failures.jsonl",
    "log_cache": true,
    "anthropic_prompt_cache": true
  },
  "entities": {
    "similarity_threshold": 0.8,
    "min_skeleton_len": 3,
    "sample_claims_per_member": 12,
    "prefix_similarity": 0.93,
    "guard_min_context": 0.05,
    "guard_cap": 0.5,
    "short_name_max_chars": 8,
    "entity_id_prefix": "e",
    "entity_id_digits": 4,
    "analyzer": {
      "model": "dicta-il/dictabert-joint",
      "batch_size": 4,
      "device": null,
      "min_free_gpu_mb": 2048,
      "fingerprint_chars": 12
    },
    "merge_method": "multi_signal_v3_context_guard",
    "eval": {
      "reviewed": "/mnt/SSD/coding/backup_data_wiki_from_whatsapp/2026_11_07_data/step_4_entities/entities_edited.json",
      "base_fraction": 0.8
    },
    "disallowed_entity_pos": [
      "VERB", "ADV", "ADP", "AUX", "CCONJ", "SCONJ", "DET", "PRON", "PART", "INTJ", "PUNCT"
    ],
    "signals": {
      "co_occur": "co_occur",
      "confident_contact": "confident_contact",
      "seed": "seed",
      "prefix": "prefix",
      "string": "string",
      "transliteration": "transliteration"
    }
  },
  "input": {
    "cutoff_date": "2026-09-01",
    "export_filename": "chat_android.json",
    "updates_dir": "updates"
  },
  "embedding": {
    "provider": "gemini",
    "model": "gemini-embedding-001",
    "output_dimensionality": 768,
    "batch_size": 100,
    "save_every_batches": 50,
    "cache_dir": "shared/embedding_cache",
    "max_retries": 5,
    "retry_backoff_seconds": 2.0,
    "task_types": {
      "similarity": "SEMANTIC_SIMILARITY",
      "query": "RETRIEVAL_QUERY",
      "document": "RETRIEVAL_DOCUMENT"
    },
    "prompt_task_model_prefixes": ["gemini-embedding-2"],
    "prompt_templates": {
      "similarity": "task: sentence similarity | query: {text}",
      "query": "task: search result | query: {text}",
      "document": "title: none | text: {text}"
    },
    "ab": {
      "backup_dir": "/mnt/SSD/coding/backup_data_wiki_from_whatsapp/2026_11_07_data",
      "models": ["gemini-embedding-001", "gemini-embedding-2"],
      "pairs": 500,
      "seed": 0,
      "recall_target": 0.9,
      "local_text_prefix": {"e5": "query: "}
    }
  },
  "classifier": {
    "stages": {
      "knowledge": {"provider": "typesafe", "model": "jev-latest"},
      "assign": {"provider": "typesafe", "model": "jev-latest"}
    },
    "fallback": {"provider": "anthropic", "model": "claude-haiku-5-5"},
    "concurrency": 8,
    "cache_dir": "shared/classifier_cache",
    "failure_log": "shared/classifier_failures.jsonl",
    "max_choice_options": 255,
    "max_score_levels": 10,
    "anthropic": {"effort": "low", "max_tokens": 4096}
  },
  "threads": {
    "gold_windows": [
      {"start": "2022-10-25T18:00", "end": "2022-10-25T21:00"},
      {"start": "2023-09-11T08:00", "end": "2023-09-11T11:00"},
      {"start": "2023-10-10T13:00", "end": "2023-10-10T16:00"},
      {"start": "2024-08-15T17:00", "end": "2024-08-15T20:00"},
      {"start": "2025-01-13T21:00", "end": "2025-01-14T00:00"},
      {"start": "2025-06-01T11:00", "end": "2025-06-01T14:00"},
      {"start": "2025-11-16T19:00", "end": "2025-11-16T22:00"},
      {"start": "2026-05-22T17:00", "end": "2026-05-22T20:00"}
    ],
    "gold_suggest": {
      "windows": 8,
      "hours": 3,
      "seed": 0,
      "min_messages": 40,
      "max_messages": 120,
      "min_threads": 2
    }
  },
  "classify": {
    "classifier_stage": "knowledge",
    "question_language": "en",
    "questions": {
      "he": "השיחה הזו, מקבוצת וואטסאפ על פונדקאות לגייז, נושאת ידע מועיל לחברי הקבוצה שכדאי לשמור: המלצות, חוויות אישיות, מידע משפטי, כספי או רפואי, השוואת ספקים (סוכנויות, מרפאות, עורכי דין) או השוואת מדינות. רכילות, לוגיסטיקה מקומית, מכירת חפצים, ויכוחים לא רלוונטיים וצ'יטצ'אט חברתי אינם נחשבים ידע.",
      "en": "This conversation, from a WhatsApp group about surrogacy for gay men, carries knowledge that is useful to the group's members and worth keeping: recommendations, personal experiences, legal, financial or medical information, or comparisons of providers (agencies, clinics, lawyers) or of countries. Gossip, local logistics, selling items, off-topic arguments and social small talk do not count as knowledge."
    },
    "threshold": 0.18,
    "min_messages": 1,
    "min_senders": 1,
    "eval_backup_dir": "/mnt/SSD/coding/backup_data_wiki_from_whatsapp/2026_11_07_data",
    "eval_reason_groups": {
      "failed_call": "classification_error",
      "heuristic": "filtered_by_heuristic",
      "manual": "manual_"
    },
    "eval_fallback_sample": 150,
    "eval_seed": 0,
    "eval_recall_targets": [0.95, 0.98],
    "eval_size_buckets": [3, 6, 11, 21, 51],
    "eval_bootstrap": 1000
  },
  "extract": {
    "render": {
      "alias": "משתתף {n}",
      "new_marker": "(חדשה)",
      "reply_mark": "↩",
      "reactions_label": "תגובות",
      "quote_max_chars": 160,
      "existing_claim_prefix": "C"
    },
    "claim_id_hash_chars": 8,
    "message_fingerprint_chars": 12
  },
  "aggregate": {
    "embedding_kind": "similarity",
    "merge_threshold": {"shared_entity": 0.95, "no_shared_entity": 0.96},
    "contradiction_threshold": 0.9,
    "opposing_stances": ["positive", "negative"],
    "group_id_prefix": "g-",
    "group_id_hash_chars": 8,
    "review": {
      "suggestion_band": 0.04,
      "similarity_block_rows": 1024,
      "max_page_size": 200,
      "partner_suggestions": 5
    },
    "eval": {
      "backup_dir": "/mnt/SSD/coding/backup_data_wiki_from_whatsapp/2026_11_07_data",
      "pair_labels": "step_5_aggregate/eval/pair_labels.json",
      "bands": [0.9, 0.92, 0.93, 0.94, 0.95, 0.96, 0.97],
      "settings": [
        {"name": "embedding 0.93", "shared": 0.93, "other": 0.93, "number_guard": false},
        {"name": "embedding 0.94", "shared": 0.94, "other": 0.94, "number_guard": false},
        {"name": "embedding 0.95", "shared": 0.95, "other": 0.95, "number_guard": false},
        {"name": "embedding 0.96", "shared": 0.96, "other": 0.96, "number_guard": false},
        {"name": "embedding 0.97", "shared": 0.97, "other": 0.97, "number_guard": false},
        {"name": "entity 0.92/0.95", "shared": 0.92, "other": 0.95, "number_guard": false},
        {"name": "entity 0.93/0.96", "shared": 0.93, "other": 0.96, "number_guard": false},
        {"name": "entity 0.94/0.96", "shared": 0.94, "other": 0.96, "number_guard": false},
        {"name": "entity 0.95/0.96", "shared": 0.95, "other": 0.96, "number_guard": false},
        {"name": "entity+numbers 0.93/0.96", "shared": 0.93, "other": 0.96, "number_guard": true},
        {"name": "entity+numbers 0.94/0.96", "shared": 0.94, "other": 0.96, "number_guard": true},
        {"name": "entity+numbers 0.95/0.96", "shared": 0.95, "other": 0.96, "number_guard": true},
        {"name": "numbers 0.96", "shared": 0.96, "other": 0.96, "number_guard": true}
      ],
      "base_fraction": 0.8,
      "edit_suffix": " (נערך)"
    }
  },
  "plan": {
    "max_pages": 30,
    "min_depth": 3,
    "max_depth": 4,
    "slug_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "slug_max_length": 40,
    "stage": "plan",
    "max_output_tokens": 100000,
    "context_window_tokens": 1000000,
    "max_model_calls": 3,
    "example_group_ids": {"min": 3, "max": 8},
    "coverage": {
      "stage": "assign",
      "sample_size": 300,
      "seed": 23,
      "none_option": "none",
      "confident_probability": 0.6,
      "max_unplaced_share": 0.15,
      "small_page_factor": 0.25,
      "large_page_factor": 3.0,
      "revise": true
    },
    "review": {
      "undo_depth": 20,
      "groups_page_size": 50,
      "max_groups_page_size": 200,
      "label_findings": {"few_groups": 10, "large_share": 0.25}
    }
  },
  "assign": {
    "stage": "assign",
    "confident_probability": 0.5,
    "second_page": {"min_probability": 0.3, "min_pair_probability": 0.75},
    "label_probability": 0.7,
    "screen_probability": 0.3,
    "kept_probability": 0.1,
    "max_label_questions": 100,
    "question_prefix": {"label": "label:", "screen": "screen:"},
    "proposals": {
      "stage": "propose",
      "min_groups": 3,
      "max_groups_per_call": 300,
      "max_proposals": 8,
      "max_output_tokens": 16000,
      "id_prefix": "prop-",
      "id_hash_chars": 8
    }
  },
  "pages": {
    "okf_version": "0.2",
    "page_type": "wiki-page",
    "lang": "he",
    "dir": "rtl",
    "statuses": ["draft", "stable", "deprecated"],
    "default_status": "stable",
    "stale_after_days": 180
  },
  "review": {
    "host": "127.0.0.1",
    "port": 8780,
    "port_search_limit": 20,
    "health_timeout_seconds": 1.0,
    "watch_interval_seconds": 0.5,
    "watch_debounce_seconds": 0.3,
    "lock_timeout_seconds": 10.0,
    "sse_keepalive_seconds": 15.0,
    "sse_queue_size": 256,
    "shutdown_timeout_seconds": 3,
    "dev_origins": ["http://localhost:5173", "http://127.0.0.1:5173"],
    "web_dist": "web/review/dist",
    "log_folder": "review_tool",
    "jobs": {
      "log_lines": 500,
      "progress_interval_seconds": 0.25,
      "stop_timeout_seconds": 10.0,
      "history_limit": 20,
      "highlight_patterns": ["manual edits now only in the backup"]
    }
  },
  "site": {
    "url": "https://gaysurrogacy.co.il/",
    "coffee_url": "https://buymeacoffee.com/gilmelnik",
    "coffee_text": "אחזקת האתר והאחסון שלו עולים כסף. קפה אני כבר שותה מספיק — אבל התינוק שלי שוב איבד מוצץ.",
    "coffee_link_text": "אפשר לקנות לו חדש 🍼",
    "custom_dir": "overrides",
    "docs_dir": "docs",
    "mkdocs_file": "mkdocs.yml",
    "keep": ["stylesheets"],
    "labels_dir": "labels",
    "home_nav_title": "בית",
    "home_intro": "!!! info \"אודות\"\n    ויקי זה מסכם ידע שנאסף בקבוצת וואטסאפ קהילתית. כל המידע אנונימי ומשקף דעות של חברי הקבוצה - אינו תחליף לייעוץ מקצועי.",
    "labels_nav_title": "תגיות",
    "label_pages_heading": "דפים עם התגית",
    "label_kind_titles": {
      "country": "מדינות",
      "us-state": "מדינות בארה\"ב",
      "family-situation": "מצב משפחתי",
      "context": "הקשר",
      "content-type": "סוג תוכן",
      "topic": "נושאים"
    },
    "redirect_text": "הדף הזה אוחד לתוך",
    "hebrew_search": {
      "enabled": true,
      "field": "variants",
      "boost": 0.5
    },
    "mkdocs": {
      "site_name": "ויקי פונדקאות לגייז",
      "site_description": "ידע קהילתי אנונימי על תהליכי פונדקאות",
      "theme": {
        "name": "material",
        "language": "he",
        "direction": "rtl",
        "features": [
          "navigation.sections",
          "navigation.top",
          "navigation.indexes",
          "search.highlight",
          "search.suggest",
          "content.code.copy"
        ],
        "palette": [
          {
            "scheme": "default",
            "primary": "teal",
            "accent": "teal",
            "toggle": {"icon": "material/weather-night", "name": "עבור למצב כהה"}
          },
          {
            "scheme": "slate",
            "primary": "teal",
            "accent": "teal",
            "toggle": {"icon": "material/weather-sunny", "name": "עבור למצב בהיר"}
          }
        ]
      },
      "plugins": [{"search": {"lang": "he"}}],
      "markdown_extensions": [
        "admonition",
        "md_in_html",
        "pymdownx.details",
        "pymdownx.superfences",
        "attr_list",
        "tables",
        "toc",
        "footnotes"
      ]
    }
  },
  "mcp": {
    "route": "/mcp",
    "index_file": "wiki_index.json",
    "index_version": 1,
    "search_file": "wiki_search.json",
    "search_version": 1,
    "assets_origin": "https://assets.local",
    "allowed_origin_hostnames": ["gaysurrogacy.co.il", "localhost", "127.0.0.1", "[::1]"],
    "server": {
      "name": "gaysurrogacy-wiki",
      "title": "Gay Surrogacy Wiki (Hebrew)",
      "version": "1.0.0",
      "instructions": "Read-only access to gaysurrogacy.co.il, a Hebrew (right-to-left) community knowledge base about surrogacy for gay couples and single gay men, distilled from the discussions of an Israeli community chat group and organised into linked pages (countries, agencies, costs, medical and legal steps, life after birth). Search works best in Hebrew; Latin names and English aliases (e.g. Colombia, USA) also find pages. Each page reports claim statistics: how many distinct members backed (supporting) or disputed (opposing) its claims and the first/last date they were made, so you can judge how established, contested or dated the information is. The content is community experience, not legal, medical or financial advice, and can be out of date: say so when you rely on it and suggest confirming with professionals or official sources. Workflow: search (or list_pages / list_labels to browse) -> get_page with a page id -> get_links to walk to related pages. Page bodies link to other pages as [[page_id|text]]; pass that page_id to get_page. Cite pages by their url."
    },
    "search": {
      "default_limit": 10,
      "max_limit": 50,
      "snippet_chars": 200,
      "min_stem_length": 3,
      "min_wildcard_length": 2,
      "hebrew_prefixes": [
        "ו", "ה", "ב", "ל", "מ", "ש", "כ",
        "וה", "וב", "ול", "ומ", "וש", "וכ", "שה", "שב", "של", "שמ", "שכ", "מה", "כש",
        "ושה", "ושב", "ושל", "ומה", "וכש"
      ],
      "field_weights": {
        "title": 10, "aliases": 8, "entities": 5, "questions": 4, "summary": 4,
        "description": 3, "labels": 3, "body": 1
      },
      "match_weights": {"exact": 1.0, "text_prefix": 0.8, "wildcard": 0.6, "query_prefix": 0.5}
    }
  },
  "update": {}
}
