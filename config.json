{
  "data_dir": "data",
  "logging": {
    "level": "INFO",
    "max_bytes": 5242880,
    "backup_count": 3
  },
  "llm_client": {
    "stages": {
      "classify": {"provider": "gemini", "model": "gemini-3.1-flash-lite", "thinking_param": "minimal"},
      "extract": {"provider": "anthropic", "model": "claude-sonnet-5-5", "thinking_param": "low"},
      "plan": {"provider": "anthropic", "model": "claude-opus-5-5", "thinking_param": "high"},
      "generate": {"provider": "anthropic", "model": "claude-sonnet-5-5", "thinking_param": "high"},
      "research": {"provider": "gemini", "model": "gemini-3.5-flash", "thinking_param": "high"},
      "write": {"provider": "anthropic", "model": "claude-sonnet-5-5", "thinking_param": "high"},
      "review": {"provider": "anthropic", "model": "claude-opus-5-5", "thinking_param": "high"},
      "apply": {"provider": "anthropic", "model": "claude-sonnet-5-5", "thinking_param": "medium"},
      "propose": {"provider": "anthropic", "model": "claude-sonnet-5-5", "thinking_param": "low"},
      "update": {"provider": "anthropic", "model": "claude-sonnet-5-5", "thinking_param": "medium"}
    },
    "batch_poll_interval": 30.0,
    "max_tokens_ceiling": 16384,
    "json_parse_retries": 2,
    "default_temperature": 0.2,
    "default_max_tokens": 8192,
    "cache_dir": "shared/llm_cache",
    "failure_log": "shared/llm_failures.jsonl",
    "log_cache": true,
    "anthropic_prompt_cache": true,
    "enable_web_search": null
  },
  "entities": {
    "similarity_threshold": 0.88,
    "min_skeleton_len": 3,
    "sample_claims_per_member": 12,
    "prefix_similarity": 0.93,
    "topic_guard_cap": 0.5,
    "short_name_max_chars": 8,
    "distance_method": "string_plus_transliteration_v2",
    "disallowed_entity_pos": [
      "VERB", "ADV", "ADP", "AUX", "CCONJ", "SCONJ", "DET", "PRON", "PART", "INTJ", "PUNCT"
    ],
    "signals": {
      "co_occur": "co_occur",
      "confident_contact": "confident_contact",
      "seed": "seed",
      "prefix": "prefix",
      "string": "string",
      "transliteration": "transliteration"
    }
  },
  "input": {
    "cutoff_date": "2026-09-01",
    "export_filename": "chat_android.json",
    "updates_dir": "updates"
  },
  "embedding": {
    "provider": "gemini",
    "model": "gemini-embedding-001",
    "output_dimensionality": 768,
    "batch_size": 100,
    "save_every_batches": 50,
    "cache_dir": "shared/embedding_cache",
    "max_retries": 5,
    "retry_backoff_seconds": 2.0,
    "task_types": {
      "similarity": "SEMANTIC_SIMILARITY",
      "query": "RETRIEVAL_QUERY",
      "document": "RETRIEVAL_DOCUMENT"
    },
    "prompt_task_model_prefixes": ["gemini-embedding-2"],
    "prompt_templates": {
      "similarity": "task: sentence similarity | query: {text}",
      "query": "task: search result | query: {text}",
      "document": "title: none | text: {text}"
    },
    "ab": {
      "backup_dir": "/mnt/SSD/coding/backup_data_wiki_from_whatsapp/2026_11_07_data",
      "models": ["gemini-embedding-001", "gemini-embedding-2"],
      "pairs": 500,
      "seed": 0,
      "recall_target": 0.9,
      "local_text_prefix": {"e5": "query: "}
    }
  },
  "classifier": {
    "stages": {
      "knowledge": {"provider": "typesafe", "model": "jev-latest"},
      "assign": {"provider": "typesafe", "model": "jev-latest"}
    },
    "fallback": {"provider": "anthropic", "model": "claude-haiku-5-5"},
    "concurrency": 8,
    "cache_dir": "shared/classifier_cache",
    "failure_log": "shared/classifier_failures.jsonl",
    "max_choice_options": 255,
    "max_score_levels": 10,
    "anthropic": {"effort": "low", "max_tokens": 4096}
  },
  "threads": {
    "gold_windows": [
      {"start": "2022-10-25T18:00", "end": "2022-10-25T21:00"},
      {"start": "2023-09-11T08:00", "end": "2023-09-11T11:00"},
      {"start": "2023-10-10T13:00", "end": "2023-10-10T16:00"},
      {"start": "2024-08-15T17:00", "end": "2024-08-15T20:00"},
      {"start": "2025-01-13T21:00", "end": "2025-01-14T00:00"},
      {"start": "2025-06-01T11:00", "end": "2025-06-01T14:00"},
      {"start": "2025-11-16T19:00", "end": "2025-11-16T22:00"},
      {"start": "2026-05-22T17:00", "end": "2026-05-22T20:00"}
    ],
    "gold_suggest": {
      "windows": 8,
      "hours": 3,
      "seed": 0,
      "min_messages": 40,
      "max_messages": 120,
      "min_threads": 2
    }
  },
  "classify": {
    "classifier_stage": "knowledge",
    "question_language": "en",
    "questions": {
      "he": "השיחה הזו, מקבוצת וואטסאפ על פונדקאות לגייז, נושאת ידע מועיל לחברי הקבוצה שכדאי לשמור: המלצות, חוויות אישיות, מידע משפטי, כספי או רפואי, השוואת ספקים (סוכנויות, מרפאות, עורכי דין) או השוואת מדינות. רכילות, לוגיסטיקה מקומית, מכירת חפצים, ויכוחים לא רלוונטיים וצ'יטצ'אט חברתי אינם נחשבים ידע.",
      "en": "This conversation, from a WhatsApp group about surrogacy for gay men, carries knowledge that is useful to the group's members and worth keeping: recommendations, personal experiences, legal, financial or medical information, or comparisons of providers (agencies, clinics, lawyers) or of countries. Gossip, local logistics, selling items, off-topic arguments and social small talk do not count as knowledge."
    },
    "threshold": 0.18,
    "min_messages": 3,
    "min_senders": 2,
    "eval_backup_dir": "/mnt/SSD/coding/backup_data_wiki_from_whatsapp/2026_11_07_data",
    "eval_reason_groups": {
      "failed_call": "classification_error",
      "heuristic": "filtered_by_heuristic",
      "manual": "manual_"
    },
    "eval_fallback_sample": 150,
    "eval_seed": 0,
    "eval_recall_targets": [0.95, 0.98],
    "eval_size_buckets": [3, 6, 11, 21, 51],
    "eval_bootstrap": 1000
  },
  "extract": {
    "render": {
      "alias": "משתתף {n}",
      "new_marker": "(חדשה)",
      "reply_mark": "↩",
      "reactions_label": "תגובות",
      "quote_max_chars": 160,
      "existing_claim_prefix": "C"
    },
    "claim_id_hash_chars": 8,
    "message_fingerprint_chars": 12
  },
  "aggregate": {},
  "plan": {
    "max_pages": 30
  },
  "pages": {
    "okf_version": "0.2",
    "page_type": "wiki-page",
    "lang": "he",
    "dir": "rtl",
    "statuses": ["draft", "stable", "deprecated"],
    "default_status": "stable",
    "stale_after_days": 180
  },
  "review": {
    "host": "127.0.0.1",
    "port": 8780,
    "port_search_limit": 20,
    "health_timeout_seconds": 1.0,
    "watch_interval_seconds": 0.5,
    "watch_debounce_seconds": 0.3,
    "lock_timeout_seconds": 10.0,
    "sse_keepalive_seconds": 15.0,
    "sse_queue_size": 256,
    "shutdown_timeout_seconds": 3,
    "dev_origins": ["http://localhost:5173", "http://127.0.0.1:5173"],
    "web_dist": "web/review/dist",
    "log_folder": "review_tool",
    "jobs": {
      "log_lines": 500,
      "progress_interval_seconds": 0.25,
      "stop_timeout_seconds": 10.0,
      "history_limit": 20,
      "highlight_patterns": ["manual edits now only in the backup"]
    }
  },
  "site": {
    "url": "https://gaysurrogacy.co.il/",
    "coffee_url": "https://buymeacoffee.com/gilmelnik",
    "coffee_text": "אחזקת האתר והאחסון שלו עולים כסף. קפה אני כבר שותה מספיק — אבל התינוק שלי שוב איבד מוצץ.",
    "coffee_link_text": "אפשר לקנות לו חדש 🍼",
    "custom_dir": "overrides"
  },
  "update": {}
}
