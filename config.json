{
  "data_dir": "data",
  "logging": {
    "level": "INFO",
    "max_bytes": 5242880,
    "backup_count": 3
  },
  "llm_client": {
    "stages": {
      "classify": {"provider": "gemini", "model": "gemini-3.1-flash-lite"},
      "extract": {"provider": "anthropic", "model": "claude-sonnet-5"},
      "plan": {"provider": "gemini", "model": "gemini-3.5-flash"},
      "generate": {"provider": "anthropic", "model": "claude-sonnet-5"},
      "research": {"provider": "gemini", "model": "gemini-3.5-flash"}
    },
    "batch_poll_interval": 30.0,
    "max_tokens_ceiling": 16384,
    "json_parse_retries": 2,
    "default_temperature": 0.2,
    "default_max_tokens": 8192,
    "cache_dir": "data/shared/llm_cache",
    "failure_log": "data/shared/llm_failures.jsonl",
    "log_cache": true,
    "anthropic_prompt_cache": true,
    "enable_web_search": null
  },
  "entities": {
    "similarity_threshold": 0.88,
    "min_skeleton_len": 3,
    "sample_claims_per_member": 12,
    "prefix_similarity": 0.93,
    "topic_guard_cap": 0.5,
    "short_name_max_chars": 8,
    "distance_method": "string_plus_transliteration_v2",
    "disallowed_entity_pos": [
      "VERB", "ADV", "ADP", "AUX", "CCONJ", "SCONJ", "DET", "PRON", "PART", "INTJ", "PUNCT"
    ],
    "signals": {
      "co_occur": "co_occur",
      "confident_contact": "confident_contact",
      "seed": "seed",
      "prefix": "prefix",
      "string": "string",
      "transliteration": "transliteration"
    }
  }
}
