        "apply_failed": "The apply failed and no file was written; the suggestion stays accepted. The error: {error}",
        "nothing_chosen": "No suggestion was chosen to apply.",
        "none_accepted": "No suggestion is accepted and waiting to be applied."
      }
    }
  },
