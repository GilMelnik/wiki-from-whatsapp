# Copy to .env and fill in your keys:
#   cp .env.example .env
#
# .env holds secrets only. All non-secret LLM configuration (provider/model per
# stage, cache/failure paths, batch poll interval, cache logging)
# lives in config.json.
#
# Shell exports override .env values. This file is safe to commit (no real secrets).

# --- API keys (read by each provider's SDK) ---
# Only set the keys for providers you use.

# GOOGLE_API_KEY is used by the embedder (Gemini embeddings).
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY is used by the LLM stages (config.json llm_client.stages).
ANTHROPIC_API_KEY=
# TYPESAFE_API_KEY is used by the classifier stages (config.json classifier.stages).
TYPESAFE_API_KEY=

# --- Data folder (optional) ---
# WIKI_DATA_DIR replaces config.json data_dir (a relative path is resolved against the
# project root), e.g. a private folder for one task:
# WIKI_DATA_DIR=data/scratch/my-task
