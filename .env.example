# Copy to .env and fill in your keys:
#   cp .env.example .env
#
# .env holds secrets only. All non-secret LLM configuration (provider/model per
# stage, cache/failure paths, batch poll interval, cache logging, web-search
# toggle) lives in utils/llm_client/config.json.
#
# Shell exports override .env values. This file is safe to commit (no real secrets).

# --- API keys (read by each provider's SDK) ---
# Only set the keys for providers you use.

GOOGLE_API_KEY=your-google-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
